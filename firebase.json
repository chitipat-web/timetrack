{
  "hosting": {
    "site": "rudyhr",
    "public": "_site",
    "ignore": ["**/.*"],
    "headers": [
      {
        "regex": "^/(index\\.html|sw\\.js|manifest\\.json)?$",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/version.json",
        "headers": [{ "key": "Cache-Control", "value": "no-store" }]
      }
    ]
  }
}
